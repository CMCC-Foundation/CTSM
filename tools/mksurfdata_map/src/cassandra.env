# cassandra environment for cmcc-esm3 clm tools

module purge
# fortran compiler
module load oneapi-2025.0.4/2025.0.4-bwtfc 
#netcdf C (require environment variable NETCDF_C_DIR)
module load oneapi-2025.0.4/netcdf-c/4.9.2-hbdkx
#netcdf Fortran (require environment variable NETCDF_FORTRAN_DIR)
module load  oneapi-2025.0.4/netcdf-fortran/4.6.1-k36gq

# set environment variables to compile mksurfdatamap
export USER_FC=$FC
export LIB_NETCDF=$NETCDF_FORTRAN_LIB
export INC_NETCDF=$NETCDF_FORTRAN_INCLUDE

echo "cassandra machine environment loaded"
